{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "172.19.0.1",
      "listen_port": 1080
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "172.19.0.1",
      "listen_port": 1081
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "NODE_HOST",
      "server_port": 443,
      "uuid": "YOUR_UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "NODE_HOST",
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        },
        "reality": {
          "enabled": true,
          "public_key": "NODE_PUBLIC_KEY",
          "short_id": "NODE_SHORT_ID"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "openrouter.ai",
          "claude.ai",
          "anthropic.com"
        ],
        "outbound": "proxy"
      },
      {
        "domain_suffix": [
          "telegram.org",
          "t.me",
          "telesco.pe"
        ],
        "outbound": "proxy"
      },
      {
        "domain_suffix": [
          "ithyper.ru"
        ],
        "outbound": "proxy"
      },
      {
        "domain_suffix": [
          "openai.com",
          "chatgpt.com",
          "oaistatic.com",
          "oaiusercontent.com",
          "oaistatsig.com"
        ],
        "outbound": "proxy"
      }
    ],
    "final": "direct"
  }
}
